---
layout: base.njk
fullBleed: true
---
<div class="hero">
  <div class="wrap hero-inner">
    {% if site.portrait %}
    <img class="hero-portrait" src="{{ site.portrait | url }}"
         alt="{{ site.portrait_alt or site.name }}" width="240" height="300"
         fetchpriority="high" decoding="async">
    {% endif %}
    <div class="hero-text">
      <h1>{{ site.name }}</h1>
      <p class="tagline">{{ site.tagline }}</p>
      <p class="themes">{{ site.themes }}</p>
    </div>
  </div>
</div>

<div class="wrap">

{% if pages.home.latest_heading %}<h2 class="section-heading">{{ pages.home.latest_heading }}</h2>{% endif %}
{% set entries = home.latest %}
{% set showYears = false %}
{% include "entry-list.njk" %}

{% if pages.home.progress_heading %}<h2 class="section-heading">{{ pages.home.progress_heading }}</h2>{% endif %}
{% set entries = projects | featured | withLabel(pages.projects.nav_title or "Projects") %}
{% include "entry-list.njk" %}

{% if pages.home.about_heading %}<h2 class="section-heading">{{ pages.home.about_heading }}</h2>{% endif %}
<div class="about-block">
  {% for para in site.about %}<p>{{ para }}</p>{% endfor %}
  <div class="buttons">
    <a class="btn btn-solid" href="{{ routes.about | url }}">{{ pages.home.bio_button or "Read full bio" }}</a>
    {% if site.email %}<a class="btn btn-ghost" href="mailto:{{ site.email }}">{{ pages.home.contact_button or "Get in touch" }}</a>{% endif %}
  </div>
</div>

<p class="currently">{{ site.currently }}</p>

</div>
