---
layout: base.njk
---
{# Layout for prose pages. Keeps the heading and wrapper markup out of the
   Markdown file, so the body can be edited safely in a rich-text editor.
   NOTE: front matter must be the very first thing in this file — anything
   above it, even a comment, stops Eleventy parsing it. #}
<div class="page-header">
  <h1>{{ heading or title }}</h1>
</div>

<div class="prose">
{{ content | safe }}
</div>
