{# Renders `entries` grouped by year. Shared by every index page. #}

{% if entries | length > 6 %}
<div class="filter">
  <label for="filter-input" class="visually-hidden">Filter this list</label>
  <input id="filter-input" type="search" placeholder="Filter by title, venue or year…" autocomplete="off">
  <p class="filter-status" role="status" aria-live="polite"></p>
</div>
{% endif %}

{% for group in entries | byYear %}
<section class="year-group">
  <h2 class="year">{{ group.year }}</h2>
  <ul class="entries">
    {% for entry in group.items %}
    <li class="entry"{% if entry.lang %} lang="{{ entry.lang }}"{% endif %}>
      <h3 class="entry-title">
        {% if entry.url %}<a href="{{ entry.url }}">{{ entry.title }}</a>{% else %}{{ entry.title }}{% endif %}
      </h3>
      <p class="entry-meta">
        {% if entry.venue %}<span class="venue">{{ entry.venue }}</span>{% endif %}
        {% if entry.authors %}<span class="authors">{{ entry.authors }}</span>{% endif %}
        {% if entry.date %}<span class="date">{{ entry.date }}</span>{% endif %}
        {% if entry.status %}<span class="status">{{ entry.status }}</span>{% endif %}
      </p>
      {% if entry.note %}<p class="entry-note">{{ entry.note }}</p>{% endif %}
      {% if entry.pdf %}<p class="entry-links"><a class="pdf" href="{{ entry.pdf }}">PDF</a></p>{% endif %}
    </li>
    {% endfor %}
  </ul>
</section>
{% endfor %}
