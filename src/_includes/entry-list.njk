{# Renders `entries`. Set `showYears = false` before including to omit year headings. #}

{% if showYears === false %}
<ul class="entries">
  {% for entry in entries %}{% include "entry.njk" %}{% endfor %}
</ul>
{% else %}
{% for group in entries | byYear %}
<section class="year-group">
  <h2 class="year">{{ group.year }}</h2>
  <ul class="entries">
    {% for entry in group.items %}{% include "entry.njk" %}{% endfor %}
  </ul>
</section>
{% endfor %}
{% endif %}
