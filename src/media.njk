---
layout: base.njk
permalink: /media/
eleventyComputed:
  title: "{{ pages.media.nav_title or 'Media' }}"
  description: "{{ pages.media.seo }}"
---
<div class="page-header">
  <h1>{{ pages.media.heading or "Media & public engagement" }}</h1>
  {% if pages.media.intro %}<p>{{ pages.media.intro }}</p>{% endif %}
</div>

{% include "filter.njk" %}

{% set talks = media | where("kind", "talk") %}
{% if talks | length %}
<section class="entry-section">
  {% if pages.media.talks_heading %}<h2 class="section-heading">{{ pages.media.talks_heading }}</h2>{% endif %}
  {% set entries = talks %}
  {% set showYears = true %}
  {% include "entry-list.njk" %}
</section>
{% endif %}

{% set press = media | where("kind", "press") %}
{% if press | length %}
<section class="entry-section">
  {% if pages.media.press_heading %}<h2 class="section-heading">{{ pages.media.press_heading }}</h2>{% endif %}
  {% set entries = press %}
  {% set showYears = true %}
  {% include "entry-list.njk" %}
</section>
{% endif %}

{% set affiliations = media | where("kind", "affiliation") %}
{% if affiliations | length %}
<section class="entry-section">
  {% if pages.media.affiliations_heading %}<h2 class="section-heading">{{ pages.media.affiliations_heading }}</h2>{% endif %}
  {% set entries = affiliations %}
  {% set showYears = false %}
  {% include "entry-list.njk" %}
</section>
{% endif %}
